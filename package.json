{
  "name": "audiocodes-livehub-workshop-hotel-pms",
  "version": "1.0.0",
  "description": "Hotel Management Portal for AudioCodes Live Hub AI Agent workshops",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute hotel-db --local --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute hotel-db --local --file=src/db/seed.sql",
    "db:init:remote": "wrangler d1 execute hotel-db --remote --file=src/db/schema.sql",
    "db:seed:remote": "wrangler d1 execute hotel-db --remote --file=src/db/seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "wrangler": "^4.10.0",
    "typescript": "^5.7.0"
  }
}
